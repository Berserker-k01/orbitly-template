# ─────────────────────────────────────────────────────────────────────────────
# Summit One — Variables d'environnement
# Copiez ce fichier vers .env et configurez les valeurs appropriées
# ─────────────────────────────────────────────────────────────────────────────

# Environnement
NODE_ENV=development

# Port du serveur (optionnel, défaut : 3000)
PORT=3000

# ─── Email (formulaire de contact) ───────────────────────────────────────────
# Adresse de destination des demandes de contact
CONTACT_EMAIL=summit.one.contact@gmail.com

# Service d'envoi d'email — configurer l'un des services suivants :

# Option 1 : Resend (recommandé)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=noreply@summit-one.ch

# Option 2 : SendGrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxx

# Option 3 : SMTP (Nodemailer)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=summit.one.contact@gmail.com
# SMTP_PASS=xxxxxxxxxxxx

# ─── Analytics (optionnel) ───────────────────────────────────────────────────
# VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
# VITE_ANALYTICS_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── CRM / Webhooks (optionnel) ──────────────────────────────────────────────
# CRM_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ─── Calendrier / Prise de rendez-vous (optionnel) ───────────────────────────
# CALENDLY_URL=https://calendly.com/summit-one
# CAL_COM_URL=https://cal.com/summit-one
